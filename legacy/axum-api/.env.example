# App
APP_NAME=caseflow_cms
APP_ENV=development
# Development: 0.0.0.0 is OK on a laptop.
# Production: set a private IP (e.g. 192.168.100.10) or 127.0.0.1 — see deploy/secure/
APP_HOST=0.0.0.0
APP_PORT=8080
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
RUST_LOG=caseflow_cms=debug,tower_http=info,sqlx=warn

# Database — bind Postgres to 127.0.0.1 in production
DATABASE_URL=postgres://cms:cms@localhost:5432/caseflow_cms
DATABASE_MAX_CONNECTIONS=20

# JWT (change in production; >= 32 chars required when APP_ENV=production)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=604800
JWT_ISSUER=caseflow_cms

# OAuth — X / Twitter (optional; leave blank to disable)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/twitter/callback

# Security
RATE_LIMIT_RPS=30
RATE_LIMIT_BURST=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,null,http://127.0.0.1:1420,http://localhost:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost

# VPN / LAN source allowlist (empty = disabled). Example for OpenVPN + LAN + Tailscale:
# ALLOWED_CIDRS=10.8.0.0/24,192.168.100.0/24,100.64.0.0/10,127.0.0.1/32
ALLOWED_CIDRS=

# Only set true if you intentionally bind 0.0.0.0 in production behind a locked firewall
ALLOW_PUBLIC_BIND=false

# Admin seed (created on first boot if missing)
SEED_ADMIN_EMAIL=admin@caseflow.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=bigdog1991
SEED_ADMIN_NAME=Administrator
