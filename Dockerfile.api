# CaseFlow API — production image (Fly / Railway / Render / Docker)
FROM rust:1.88-bookworm AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
# Dummy build to cache deps would be nicer; keep simple for correctness
RUN cargo build -p caseflow-api --bin server --release

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates libssl3 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/release/server /usr/local/bin/caseflow-api
ENV APP_HOST=0.0.0.0
ENV API_BIND=0.0.0.0
ENV API_PORT=8080
EXPOSE 8080
CMD ["caseflow-api"]
