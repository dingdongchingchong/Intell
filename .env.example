# --- Rust API / Postgres (local or Fly/Railway/Render) ---
DATABASE_URL=postgresql://cms:cms@127.0.0.1:5433/caseflow
JWT_SECRET=change-me-jwt-secret-min-32-chars-long!!
JWT_ISSUER=caseflow
JWT_TTL_SECS=86400
API_PORT=8080

SEED_ADMIN_EMAIL=admin@caseflow.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123456
SEED_ADMIN_NAME=Administrator

# --- Next.js (local: copy to .env.local | Vercel: Project → Settings → Environment Variables) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string
# Local API. On Vercel set this to your public API origin (https://api.example.com) — not 127.0.0.1
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080

# Optional OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_ID=
# GITHUB_SECRET=
