{
  "name": "caseflow",
  "private": true,
  "description": "CaseFlow monorepo scripts",
  "scripts": {
    "dev:web": "npm --prefix frontend run dev",
    "build:web": "npm --prefix frontend run build",
    "dev:api": "cargo run -p caseflow-api --bin server",
    "seed": "cargo run -p caseflow-api --bin seed",
    "tauri:dev": "npm --prefix desktop run tauri:dev || echo 'See desktop/ and docs/DESKTOP.md'"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
